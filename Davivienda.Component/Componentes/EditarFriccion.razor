@namespace Davivienda.Componentes
@using Davivienda.Models.Modelos
@using Davivienda.Component.Componentes
@using Microsoft.AspNetCore.Components

<div class="editar-fri-backdrop" @onclick="Cerrar">
    <div class="editar-fri-panel" @onclick:stopPropagation>

        @* ******* toolbar ******* *@
        <div class="editar-fri-toolbar">
            <div class="editar-fri-toolbar-left">
                <div class="editar-fri-dot"></div>
                <span class="editar-fri-brand">Gestión de Tareas</span>
                <div class="editar-fri-divider"></div>
            </div>
            
        </div>

        @* ******* scroll contenido ******* *@
        <div class="editar-fri-scroll">

            <div class="editar-fri-titulo-section">
                <h1 class="editar-fri-titulo">Editar Fricción</h1>
                @if (Friccion != null)
                {
                    <div class="editar-fri-ref">
                        <i class="bi bi-exclamation-triangle"></i>
                        <span class="editar-fri-ref-label">Fricción:</span>
                        <span class="editar-fri-ref-nombre">@Friccion.FRI_TIP</span>
                    </div>
                }
            </div>

            <div class="editar-fri-divisor"></div>

            <div class="editar-fri-body">

                <div class="editar-fri-campo">
                    <label class="editar-fri-label">Tipo de fricción</label>
                    <input type="text"
                           @bind="fricEdit.FRI_TIP"
                           class="editar-fri-input"
                           placeholder="Ej: Error de servidor, Retraso en aprobación" />
                </div>

                <div class="editar-fri-campo">
                    <label class="editar-fri-label">Descripción del bloqueo</label>
                    <div class="editar-fri-yoopta">
                        <Yoopta Contenido="@fricEdit.FRI_DES"
                                ContenidoChanged="@((valor) => { fricEdit.FRI_DES = valor; })" />
                    </div>
                </div>

                <div class="editar-fri-fila-dos">
                    <div class="editar-fri-campo">
                        <label class="editar-fri-label">Estado actual</label>
                        <select @bind="fricEdit.FRI_EST" class="editar-fri-select">
                            <option value="Abierta">Abierta</option>
                            <option value="En Análisis">En Análisis</option>
                            <option value="Mitigada">Mitigada</option>
                            <option value="Resuelta">Resuelta</option>
                        </select>
                    </div>
                    <div class="editar-fri-campo">
                        <label class="editar-fri-label">Nivel de impacto</label>
                        <select @bind="fricEdit.FRI_IMP" class="editar-fri-select">
                            <option value="Bajo">Bajo</option>
                            <option value="Medio">Medio</option>
                            <option value="Alto">Alto</option>
                            <option value="Crítico">Crítico</option>
                        </select>
                    </div>
                </div>

                <div class="editar-fri-footer">
                    <button class="editar-fri-btn-regresar" @onclick="Cerrar">
                        <i class="bi bi-arrow-left"></i> Regresar
                    </button>
                    <button class="editar-fri-btn-guardar" @onclick="ActualizarFriccion">
                        <i class="bi bi-check-lg"></i> Actualizar registro
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>
