@namespace Davivienda.Component.Componentes
@using Davivienda.Models.Modelos
@using Davivienda.GraphQL.SDK
@implements IAsyncDisposable

<div class="detalle-backdrop" @onclick="Cerrar">
    <div class="detalle-panel" @onclick:stopPropagation>

        @* ******* toolbar ******* *@
        <div class="detalle-toolbar">
            <div class="toolbar-left">
                <div class="toolbar-dot"></div>
                <span class="toolbar-brand">Gestión de Tareas</span>
                <div class="toolbar-divider"></div>
                <span class="toolbar-bitacora-label">Ver Bitácora:</span>
                <select class="toolbar-select" @onchange="ManejarCambioBitacora">
                    <option value="">-- Seleccionar --</option>
                    <option value="BIT_SOL">Bitácora de Soluciones</option>
                    <option value="BIT_FRI">Bitácora de Fricciones</option>
                </select>
            </div>
            <button class="toolbar-close" @onclick="Cerrar" title="Cerrar">
                <i class="bi bi-x"></i>
            </button>
        </div>

        @* ******* contenido con scroll ******* *@
        <div class="detalle-scroll">

            @if (Tarea != null)
            {
                <div class="detalle-titulo-section">
                    <h1 class="detalle-titulo">@Tarea.TAR_NOM</h1>
                </div>

                <div class="detalle-info-section">
                    <div class="info-fila">
                        <span class="info-icono"><i class="bi bi-tag"></i></span>
                        <span class="info-label">Estado</span>
                        <select @bind="Tarea.TAR_EST" class="info-select">
                            <option value="Pendiente">Pendiente</option>
                            <option value="En Progreso">En Progreso</option>
                            <option value="Completado">Completado</option>
                        </select>
                    </div>
                    <div class="info-fila">
                        <span class="info-icono"><i class="bi bi-folder2"></i></span>
                        <span class="info-label">Proyecto asociado</span>
                        <span class="info-valor info-azul">@NombreProyecto</span>
                    </div>
                    <div class="info-fila">
                        <span class="info-icono"><i class="bi bi-diagram-3"></i></span>
                        <span class="info-label">Proceso actual</span>
                        <span class="info-valor">@NombreProceso</span>
                    </div>
                    <div class="info-fila">
                        <span class="info-icono"><i class="bi bi-calendar-check"></i></span>
                        <span class="info-label">Fecha de inicio</span>
                        <span class="info-valor info-verde">@Tarea.TAR_FEC_INI.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="info-fila">
                        <span class="info-icono"><i class="bi bi-calendar-x"></i></span>
                        <span class="info-label">Fecha de finalización</span>
                        <span class="info-valor info-rojo">
                            @(Tarea.TAR_FEC_FIN.HasValue? Tarea.TAR_FEC_FIN.Value.ToString("dd/MM/yyyy") : "Sin fecha estimada")
                        </span>
                    </div>
                </div>

                <div class="detalle-desc-section">
                    <div class="desc-header">
                        <h3 class="desc-titulo">Descripción</h3>
                        <span class="desc-subtitulo">Notas y documentos</span>
                    </div>
                    <div class="desc-editor">
                        <span class="desc-label">DESCRIPCIÓN</span>
                        <Yoopta Contenido="@Tarea.TAR_DES"
                                ContenidoChanged="@((valor) => { Tarea.TAR_DES = valor; })" />
                    </div>
                </div>

                <div class="bloques-grid">

                    <div class="detalle-bloque bloque-sol">
                        <div class="bloque-header">
                            <div class="bloque-title-group">
                                <h3 class="bloque-titulo">Soluciones</h3>
                                <span class="bloque-subtitulo">Propuestas activas</span>
                            </div>
                            <button class="btn-nueva" @onclick="AbrirModalCrearSolucion">
                                <i class="bi bi-plus-lg"></i> Nueva
                            </button>
                        </div>
                        <div class="bloque-lista">
                            @if (SolucionesList?.Any() == true)
                            {
                                @foreach (var sol in SolucionesList)
                                {
                                    <div class="bloque-item" @onclick="() => AbrirModalEditarSolucion(sol)">
                                        <div class="bloque-item-left">
                                            <div class="bloque-icono icono-sol"><i class="bi bi-lightbulb"></i></div>
                                            <span class="bloque-nombre">@sol.SOL_NOM</span>
                                        </div>
                                        <button class="btn-eliminar" @onclick:stopPropagation @onclick="() => EliminarSolucion(sol.SOL_ID)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="bloque-vacio">No hay soluciones registradas</p>
                            }
                        </div>
                    </div>

                    <div class="detalle-bloque bloque-fri">
                        <div class="bloque-header">
                            <div class="bloque-title-group">
                                <h3 class="bloque-titulo">Fricciones</h3>
                                <span class="bloque-subtitulo">Obstáculos detectados</span>
                            </div>
                            <button class="btn-nueva" @onclick="AbrirModalCrearFriccion">
                                <i class="bi bi-plus-lg"></i> Nueva
                            </button>
                        </div>
                        <div class="bloque-lista">
                            @if (FriccionesList?.Any() == true)
                            {
                                @foreach (var fri in FriccionesList)
                                {
                                    <div class="bloque-item" @onclick="() => AbrirModalEditarFriccion(fri)">
                                        <div class="bloque-item-left">
                                            <div class="bloque-icono icono-fri"><i class="bi bi-exclamation-triangle"></i></div>
                                            <span class="bloque-nombre">@fri.FRI_TIP</span>
                                        </div>
                                        <button class="btn-eliminar" @onclick:stopPropagation @onclick="() => EliminarFriccion(fri.FRI_ID)">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="bloque-vacio">No hay fricciones reportadas</p>
                            }
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>

@* ******* crear friccion ******* *@
@if (MostrarModalCrear && TipoModal == "FRICCION_NUEVA" && Tarea != null)
{
    <CrearFriccion TareaId="@Tarea.TAR_ID"
                   NombreTarea="@Tarea.TAR_NOM"
                   OnSuccess="AlCrearExitoso"
                   OnClose="CerrarModalInterno" />
}

@* ******* crear solucion ******* *@
@if (MostrarModalCrear && TipoModal == "SOLUCION_NUEVA" && Tarea != null)
{
    <CrearSolucion FriccionId="@(FriccionesList?.FirstOrDefault()?.FRI_ID ?? Guid.Empty)"
                   TareaId="@Tarea.TAR_ID"
                   NombreTarea="@Tarea.TAR_NOM"
                   OnSuccess="AlCrearExitoso"
                   OnClose="CerrarModalInterno" />
}

@* ******* editar solucion******* *@
@if (MostrarModalCrear && TipoModal == "SOLUCION_EDITAR" && SolucionSeleccionada != null)
{
    <EditarSolucion Solucion="@SolucionSeleccionada"
                    FriccionesDisponibles="@FriccionesList"
                    OnSuccess="AlCrearExitoso"
                    OnClose="CerrarModalInterno" />
}

@* ******* editar friccion ******* *@
@if (MostrarModalCrear && TipoModal == "FRICCION_EDITAR" && FriccionSeleccionada != null)
{
    <Davivienda.Componentes.EditarFriccion Friccion="@FriccionSeleccionada"
                                           OnSuccess="AlCrearExitoso"
                                           OnClose="CerrarModalInterno" />
}

@* ******* historial ******* *@
@if (MostrarModalCrear && (TipoModal == "HISTORIAL_SOLUCIONES" || TipoModal == "HISTORIAL_FRICCIONES"))
{
    <div class="modal-interno-backdrop" @onclick="CerrarModalInterno">
        <div class="modal-interno-ventana" @onclick:stopPropagation>
            <div class="modal-interno-header">
                <h3>@TituloModal</h3>
                <button class="modal-interno-cerrar" @onclick="CerrarModalInterno">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div class="modal-interno-body">
                @if (TipoModal == "HISTORIAL_SOLUCIONES")
                {
                    <BitacoraSolucion OnClose="CerrarModalInterno" />
                }
                else if (TipoModal == "HISTORIAL_FRICCIONES")
                {
                    <BitacoraFriccion OnClose="CerrarModalInterno" />
                }
            </div>
        </div>
    </div>
}
