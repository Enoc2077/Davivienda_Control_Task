@namespace Davivienda.Component.Componentes
@using Davivienda.Models.Modelos

<div class="modal-overlay-edit">
    <div class="modal-card-edit animate-pop">

        <div class="modal-head-edit">
            <div class="modal-title-group">
                <h2 class="modal-title-edit">Editar Proyecto</h2>
                <p class="modal-subtitle-edit">Actualizando información de: <strong>@Proyecto.PRO_NOM</strong></p>
            </div>
            <button class="close-x-edit" @onclick="CerrarModal">×</button>
        </div>

        <div class="modal-body-edit">
            <div class="form-grid-edit">

                <div class="input-wrap-edit full-width-edit">
                    <label>Nombre del proyecto</label>
                    <input type="text"
                           @bind="Proyecto.PRO_NOM"
                           class="input-edit"
                           placeholder="Ej: Migración de Core" />
                </div>

                <div class="input-wrap-edit full-width-edit">
                    <label>Descripción del alcance</label>
                    <textarea @bind="Proyecto.PRO_DES"
                              rows="3"
                              class="input-edit textarea-edit"
                              placeholder="Describa el alcance del proyecto..."></textarea>
                </div>

                <div class="input-wrap-edit">
                    <label>Fecha de inicio</label>
                    <input type="date"
                           @bind-value="Proyecto.PRO_FEC_INI"
                           @bind-value:format="yyyy-MM-dd"
                           class="input-edit" />
                </div>

                <div class="input-wrap-edit">
                    <label>Fecha de finalización</label>
                    <input type="date"
                           @bind-value="Proyecto.PRO_FEC_FIN"
                           @bind-value:format="yyyy-MM-dd"
                           class="input-edit" />
                </div>

                <div class="input-wrap-edit full-width-edit">
                    <label>Estado actual</label>
                    <select @bind="Proyecto.PRO_EST" class="select-edit">
                        <option value="NUEVO">Nuevo</option>
                        <option value="INICIADO">Iniciado</option>
                        <option value="EN PROCESO">En proceso</option>
                        <option value="FINALIZADO">Finalizado</option>
                    </select>
                </div>

            </div>
        </div>

        <div class="modal-foot-edit">
            <button class="btn-cancel-edit" @onclick="CerrarModal">Cancelar</button>
            <button class="btn-save-edit" @onclick="ActualizarProyecto">
                Guardar cambios
            </button>
        </div>

    </div>
</div>
